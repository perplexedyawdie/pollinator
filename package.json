{
  "name": "pollinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-pollinate study notes from two Bee conversations",
  "scripts": {
    "dev": "tsx src/local/server.ts",
    "fixtures": "tsx scripts/run-fixtures.ts",
