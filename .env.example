# Copy to .env and fill in. Used by `npm run dev` and `podman compose up`.

# Claude API key (https://console.anthropic.com). Without it, Pollinator uses Amazon Bedrock.
CLAUDE_API_KEY=

# Optional overrides
# EXTRACT_MODEL=claude-haiku-5-5
# COMPARE_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=anthropic   # or: bedrock (uses AWS credentials, AWS_REGION)
